{
  "manifest_version": 3,
  "name": "dtoc",
  "version": "1.1.0",
  "description": "Dynamic Table of Content.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.atlassian.net/wiki/*",
        "https://dev.to/*",
        "https://*.dev.to/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "dtoc Settings",
    "theme_icons": [
      {
        "dark": "icons/icon16-dark.png",
        "light": "icons/icon16-light.png",
        "size": 16
      },
      {
        "dark": "icons/icon48-dark.png",
        "light": "icons/icon48-light.png",
        "size": 48
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.css"
      ],
      "matches": [
        "https://*.atlassian.net/*",
        "https://dev.to/*",
        "https://*.dev.to/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dtoc-firefox@example.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
