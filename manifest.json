{
  "manifest_version": 3,
  "name": "dtoc for Confluence",
  "version": "1.0.0",
  "description": "Dynamic Table of Contents for Confluence pages.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.atlassian.net/wiki/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "dtoc Settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.css"
      ],
      "matches": [
        "https://*.atlassian.net/*"
      ]
    }
  ]
}