{
  "manifest_version": 3,
  "name": "dtoc",
  "version": "1.2.0",
  "description": "Dynamic Table of Content.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.atlassian.net/wiki/*",
        "https://dev.to/*",
        "https://medium.com/*",
        "https://*.medium.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "dtoc Settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.css"
      ],
      "matches": [
        "https://*.atlassian.net/*",
        "https://dev.to/*",
        "https://medium.com/*",
        "https://*.medium.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}
